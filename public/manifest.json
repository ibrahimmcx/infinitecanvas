{
  "manifest_version": 3,
  "name": "Infinite Canvas",
  "version": "1.0.0",
  "description": "Transform the website you are visiting into an immersive 3D spatial interactive universe directly from Chrome.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Launch Infinite Canvas 3D Spatial Universe",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "contextMenus",
    "sidePanel"
  ],
  "web_accessible_resources": [
    {
      "resources": ["canvas.html", "assets/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Toggle Infinite Canvas 3D Spatial Universe on current page"
    }
  }
}
